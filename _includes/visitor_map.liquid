{% assign visitor_map = site.visitor_map %}
{% if visitor_map and visitor_map.enabled %}
  {% assign title = visitor_map.title | default: 'visitor map' %}
  {% assign height = visitor_map.height | default: 340 %}
  {% assign provider = visitor_map.provider | default: 'smallcounter' %}
  {% assign map_image = visitor_map.map_image | default: '/assets/img/world.svg' %}
  {% assign visitor_dots = site.data.visitor_locations %}
  {% assign total_visits = 0 %}
  {% assign tracking_url = '' %}
  {% assign details_url = '' %}
  {% assign refresh_ms = visitor_map.refresh_ms | default: 60000 %}

  {% if provider == 'smallcounter' and visitor_map.counter_id %}
    {% assign counter_type = visitor_map.counter_type | default: 1600 %}
    {% capture tracking_url %}https://smallcounter.com/map/view.php?type={{ counter_type }}&id={{ visitor_map.counter_id }}{% endcapture %}
    {% capture details_url %}https://smallcounter.com/vmap/{{ visitor_map.counter_id }}/{% endcapture %}
    {% assign tracking_url = tracking_url | strip %}
    {% assign details_url = details_url | strip %}
  {% endif %}

  {% assign embed_url = visitor_map.embed_url | default: '' | strip %}
  {% if embed_url == '' and provider == 'mapmyvisitors' and visitor_map.widget_id %}
    {% capture embed_url %}https://mapmyvisitors.com/web/{{ visitor_map.widget_id }}{% endcapture %}
    {% assign embed_url = embed_url | strip %}
  {% endif %}

  {% assign pixel_url = visitor_map.pixel_url | default: '' | strip %}
  {% if pixel_url == '' and provider == 'mapmyvisitors' and visitor_map.pixel_id %}
    {% capture pixel_url %}https://mapmyvisitors.com/map.png?d={{ visitor_map.pixel_id }}&cl=ffffff{% endcapture %}
    {% assign pixel_url = pixel_url | strip %}
  {% endif %}
  {% if tracking_url == '' and pixel_url != '' %}
    {% assign tracking_url = pixel_url %}
  {% endif %}

  {% for dot in visitor_dots %}
    {% assign dot_visits = dot.visits | default: 1 %}
    {% assign total_visits = total_visits | plus: dot_visits %}
  {% endfor %}

  {% if map_image != '' %}
    <h2 id="visitor-map-heading">{{ title }}</h2>
    <div
      class="visitor-map visitor-map-image"
      {% if details_url != '' %}
        data-live-stats-url="{{ details_url }}"
        data-live-refresh-ms="{{ refresh_ms }}"
      {% endif %}
    >
      {% if details_url != '' %}
        <a
          class="visitor-map-link"
          href="{{ details_url }}"
          target="_blank"
          rel="external nofollow noopener"
          aria-label="Open visitor map details"
        >
      {% endif %}
      <div class="visitor-map-canvas" role="img" aria-label="World map showing visitor locations">
        <img class="visitor-map-base" src="{{ map_image | relative_url }}" alt="">
        <div class="visitor-map-dots" data-visitor-map-dots>
          {% for dot in visitor_dots %}
            {% if dot.x and dot.y %}
              {% assign dot_visits = dot.visits | default: 1 %}
              {% capture dot_label %}{{ dot.label }}: {{ dot_visits }} visits{% if dot.last_visit %}; last visit {{ dot.last_visit }}{% endif %}{% endcapture %}
              <span
                class="visitor-map-dot"
                style="left: {{ dot.x }}%; top: {{ dot.y }}%; --visitor-dot-size: {{ dot.size | default: 10 }}px"
                title="{{ dot_label | strip | escape }}"
                aria-hidden="true"
              ></span>
            {% endif %}
          {% endfor %}
        </div>
      </div>
      {% if details_url != '' %}
        </a>
      {% endif %}

      {% if total_visits > 0 %}
        <div class="visitor-map-summary" data-visitor-map-summary>
          {{ total_visits }} visits visualized from live tracked history.
        </div>
      {% endif %}

      {% if tracking_url != '' %}
        <img
          class="visitor-map-counter"
          width="1"
          height="1"
          data-visitor-map-src="{{ tracking_url }}"
          alt=""
        >
        <noscript><img class="visitor-map-counter" width="1" height="1" src="{{ tracking_url }}" alt=""></noscript>
        <script>
          (function () {
            function withCacheBust(url) {
              return url + (url.indexOf('?') === -1 ? '?' : '&') + 'cache_bust=' + Date.now();
            }

            function fetchWithTimeout(url, timeout) {
              var controller = window.AbortController ? new AbortController() : null;
              var timer = controller ? window.setTimeout(function () { controller.abort(); }, timeout) : null;
              return fetch(url, {
                cache: 'no-store',
                signal: controller ? controller.signal : undefined
              }).then(function (response) {
                if (!response.ok) throw new Error('visitor stats request failed');
                return response.text();
              }).finally(function () {
                if (timer) window.clearTimeout(timer);
              });
            }

            function statsUrls(source) {
              var freshSource = withCacheBust(source);
              return [
                'https://api.codetabs.com/v1/proxy?quest=' + encodeURIComponent(freshSource),
                'https://api.allorigins.win/raw?url=' + encodeURIComponent(freshSource)
              ];
            }

            function fetchFirst(urls, index) {
              if (index >= urls.length) return Promise.reject(new Error('visitor stats unavailable'));
              return fetchWithTimeout(urls[index], 4500).catch(function () {
                return fetchFirst(urls, index + 1);
              });
            }

            function decodeMarkerHtml(value) {
              return value.replace(/\\\//g, '/').replace(/\\"/g, '"');
            }

            function textFromHtml(value) {
              var node = document.createElement('div');
              node.innerHTML = value.replace(/<br\s*\/?>/gi, '\n');
              return node.textContent.replace(/\s+/g, ' ').trim();
            }

            function projectLongitude(longitude) {
              return Math.max(0, Math.min(100, ((longitude + 180) / 360) * 100));
            }

            function projectLatitude(latitude) {
              return Math.max(0, Math.min(100, ((90 - latitude) / 180) * 100));
            }

            function dotSize(visits) {
              return Math.max(8, Math.min(18, 7 + Math.sqrt(visits || 1) * 1.6));
            }

            function parseSmallCounterStats(html) {
              var entries = [];
              var pattern = /var point = new GLatLng\(\s*([-\d.]+)\s*,\s*([-\d.]+)\s*\);\s*var marker = createMarker\(point,\s*"[^"]*",\s*"((?:\\.|[^"\\])*)"/g;
              var match;
              while ((match = pattern.exec(html)) !== null) {
                var latitude = Number(match[1]);
                var longitude = Number(match[2]);
                var markerText = textFromHtml(decodeMarkerHtml(match[3]));
                var visitsMatch = markerText.match(/Total\s*:\s*([\d,]+)/i);
                var lastVisitMatch = markerText.match(/Last visit\s*:\s*(.+)$/i);
                var visits = visitsMatch ? Number(visitsMatch[1].replace(/,/g, '')) : 1;
                var label = markerText.replace(/\s*Total\s*:.*$/i, '').trim();
                entries.push({
                  label: label,
                  visits: visits,
                  lastVisit: lastVisitMatch ? lastVisitMatch[1].trim() : '',
                  x: projectLongitude(longitude),
                  y: projectLatitude(latitude),
                  size: dotSize(visits)
                });
              }
              return entries;
            }

            function renderLiveDots(root, entries) {
              if (!entries.length) return;
              var layer = root.querySelector('[data-visitor-map-dots]');
              var summary = root.querySelector('[data-visitor-map-summary]');
              var total = 0;
              if (!layer) return;
              layer.innerHTML = '';
              entries.forEach(function (entry) {
                total += entry.visits || 0;
                var dot = document.createElement('span');
                dot.className = 'visitor-map-dot';
                dot.style.left = entry.x.toFixed(2) + '%';
                dot.style.top = entry.y.toFixed(2) + '%';
                dot.style.setProperty('--visitor-dot-size', entry.size.toFixed(1) + 'px');
                dot.title = entry.label + ': ' + entry.visits + ' visits' + (entry.lastVisit ? '; last visit ' + entry.lastVisit : '');
                dot.setAttribute('aria-hidden', 'true');
                layer.appendChild(dot);
              });
              if (summary) {
                summary.textContent = total + ' visits visualized from live tracked history.';
              }
            }

            function refreshLiveStats(root) {
              var source = root.getAttribute('data-live-stats-url');
              if (!source) return;
              fetchFirst(statsUrls(source), 0).then(function (html) {
                renderLiveDots(root, parseSmallCounterStats(html));
              }).catch(function () {
                // Keep the static fallback dots if the external stats proxy is unavailable.
              });
            }

            var counters = document.querySelectorAll('.visitor-map-counter[data-visitor-map-src]');
            for (var i = 0; i < counters.length; i += 1) {
              var source = counters[i].getAttribute('data-visitor-map-src');
              counters[i].src = withCacheBust(source);
            }

            var liveMaps = document.querySelectorAll('.visitor-map[data-live-stats-url]');
            for (var j = 0; j < liveMaps.length; j += 1) {
              (function (root) {
                var refreshMs = Number(root.getAttribute('data-live-refresh-ms')) || 60000;
                window.setTimeout(function () { refreshLiveStats(root); }, 1200);
                window.setInterval(function () { refreshLiveStats(root); }, refreshMs);
              })(liveMaps[j]);
            }
          })();
        </script>
      {% endif %}

      {% if provider == 'smallcounter' %}
        <a class="visitor-map-credit" href="https://smallcounter.com/map/" target="_blank" rel="external nofollow noopener">tracked by SmallCounter</a>
      {% endif %}
    </div>
  {% elsif embed_url != '' or visitor_map.script_url %}
    <h2 id="visitor-map-heading">{{ title }}</h2>
    <div class="visitor-map" style="--visitor-map-height: {{ height }}px">
      {% if visitor_map.script_url %}
        <div class="visitor-map-script">
          <script src="{{ visitor_map.script_url }}"></script>
        </div>
      {% else %}
        <iframe
          title="{{ title }}"
          src="{{ embed_url }}"
          loading="lazy"
          referrerpolicy="strict-origin-when-cross-origin"
        ></iframe>
      {% endif %}

      {% if pixel_url != '' %}
        <img class="visitor-map-pixel" width="1" height="1" src="{{ pixel_url }}" alt="">
      {% endif %}
    </div>
  {% endif %}
{% endif %}
